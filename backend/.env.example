# Grant Reviewer Backend Environment Variables

# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-key-here

# Shared secret used to verify Next.js BFF signatures (required when calling protected endpoints)
# Must match `BFF_SHARED_SECRET` in `frontend/.env.local`.
BFF_SHARED_SECRET=replace-me

# LLM Model (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# LLM mode (openai|stub). Use `stub` for local API/manual verification.
LLM_MODE=openai

# Kill switch for new review submissions (true|false)
REVIEWS_ENABLED=true

# Free-tier per-user daily review limit
FREE_DAILY_REVIEW_LIMIT=5

# Max time budget for synchronous review generation (seconds)
REVIEW_TIMEOUT_SECONDS=30

# Azure OpenAI (optional, for future use)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
