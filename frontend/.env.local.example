# Clerk (required for /app/* and /api/bff/*)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Backend connection (server-only)
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Must match backend BFF_SHARED_SECRET
BFF_SHARED_SECRET=dev

# Auth mode: "clerk" (default) or "test_bypass" (dev/test only; blocked in production)
AUTH_MODE=clerk

# Required when AUTH_MODE=test_bypass
TEST_AUTH_SECRET=REPLACE_ME
# Optional token age bound in seconds (default 3600, min 60, max 86400)
TEST_AUTH_MAX_AGE_SECONDS=3600
